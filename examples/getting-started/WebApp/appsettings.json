{
  "Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning",
			"System.Net.Http.HttpClient.Phoria.Vite.DevServer.DevHttpClient": "Warning",
			"System.Net.Http.HttpClient.OtlpLogExporter": "Warning",
			"System.Net.Http.HttpClient.OtlpMetricExporter": "Warning",
			"System.Net.Http.HttpClient.OtlpTraceExporter": "Warning"
		}
  },
  "allowedHosts": "*",
  "phoria": {
    "root": "ui",
    "entry": "src/entry-client.ts",
    "ssrEntry": "src/entry-server.ts",
    "observability": {
      "logging": false,
      "logHealthChecks": false,
      "tracing": { "enabled": false, "samplingRatio": 0.1 },
      "metrics": false
    },
    "server": {
      "port": 5273
    }
  }
}
