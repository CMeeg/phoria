@page
@model IndexModel
@{
	ViewData["Title"] = "Home page";
}

<div class="inline-block">
	<a href="https://github.com/CMeeg/phoria" target="_blank" rel="noreferrer">
		<img src="~/img/phoria.svg" class="h-32 max-w-none" alt="Phoria logo" />
	</a>
</div>
<h1 class="my-16 font-bold">Phoria Islands</h1>
<div class="rounded-lg bg-white p-8 shadow-lg dark:bg-neutral-900">
	<phoria-island component="Counter" client="Client.Load" props="new { StartAt = 5 }"></phoria-island>
</div>
<p class="text-neutral-500">Click on the logos to learn more</p>
