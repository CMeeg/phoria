{
  "phoria": {
    "observability": {
      "logging": true,
      "logHealthChecks": false,
      "tracing": { "enabled": true, "samplingRatio": 0.1 },
      "metrics": true
    },
    "server": {
      "startupTimeout": 60,
      "unavailableBehavior": "Fail",
      "process": {
        "command": "node",
        "arguments": ["ui/dist/server/server.js"],
        "maxRestartAttempts": 5
      }
    }
  }
}
