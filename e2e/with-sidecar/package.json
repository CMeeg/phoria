{
	"name": "with-sidecar",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "concurrently \"pnpm:build:*\"",
		"build:islands": "cd WebApp && vite build --app",
		"build:webapp": "dotnet build WebApp/WebApp.csproj --configuration Release",
		"check": "tsc",
		"dev": "cd WebApp && tsx ./ui/src/server.ts",
		"dev:aspire": "aspire run --apphost ./Phoria.AppHost/Phoria.AppHost.csproj",
		"lint": "biome check",
		"preview": "aspire start --apphost ./Phoria.AppHost/Phoria.AppHost.csproj --environment Preview",
		"stop": "aspire stop --apphost ./Phoria.AppHost/Phoria.AppHost.csproj",
		"test:smoke": "vitest run --config vitest.smoke.config.ts"
	},
	"files": [
		"WebApp/ui/dist"
	],
	"dependencies": {
		"@opentelemetry/api-logs": "catalog:",
		"@opentelemetry/exporter-logs-otlp-http": "catalog:",
		"@opentelemetry/sdk-logs": "catalog:",
		"@phoria/phoria": "workspace:*",
		"@phoria/phoria-react": "workspace:*",
		"h3": "catalog:",
		"listhen": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@meeg/vite-plugin-inspect-config": "catalog:",
		"@phoria/vite-plugin-dotnet-dev-certs": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"concurrently": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
