{
	"name": "with-workspace",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "concurrently \"pnpm:build:*\"",
		"build:islands": "vite build --app",
		"build:webapp": "dotnet build --configuration Release",
		"check": "tsc",
		"dev": "tsx ./ui/src/server.ts",
		"lint": "biome check",
		"preview": "aspire run"
	},
	"files": [
		"ui/dist"
	],
	"dependencies": {
		"@opentelemetry/api-logs": "catalog:",
		"@opentelemetry/exporter-logs-otlp-http": "catalog:",
		"@opentelemetry/sdk-logs": "catalog:",
		"@phoria/phoria": "workspace:*",
		"@phoria/phoria-react": "workspace:*",
		"@phoria/phoria-svelte": "workspace:*",
		"@phoria/phoria-vue": "workspace:*",
		"h3": "catalog:",
		"listhen": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"svelte": "catalog:",
		"vue": "catalog:"
	},
	"devDependencies": {
		"@meeg/vite-plugin-inspect-config": "catalog:",
		"@phoria/vite-plugin-dotnet-dev-certs": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"concurrently": "catalog:",
		"postcss-preset-env": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
