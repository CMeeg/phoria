{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": ["NUGET_API_KEY"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"cache": true,
			"outputs": ["dist/**"]
		},
		"check": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"lint": {
			"cache": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"test:browser": {
			"dependsOn": ["^build"],
			"cache": true
		}
	}
}
