{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"cache": true,
			"outputs": ["dist/**"]
		},
		"build:islands": {
			"dependsOn": ["^build"],
			"cache": true,
			"outputs": ["WebApp/ui/dist/**", "ui/dist/**"]
		},
		"check": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"lint": {
			"cache": true
		},
		"preview": {
			"dependsOn": ["build"],
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"test:browser": {
			"dependsOn": ["^build"],
			"cache": true
		}
	}
}
